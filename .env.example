BOT_TOKEN=123456:telegram-bot-token
ADMIN_SECRET=change-me

# Public channel users can subscribe to in order to skip the challenge.
REQUIRED_CHANNEL=@ithueti

# Comma-separated list of chats moderated by the bot.
# Use numeric ids for private/supergroup chats, for example: -1001234567890
# Leave empty temporarily to discover chat ids from logs.
MODERATED_CHAT_IDS=-1001234567890

DATABASE_PATH=guard_bot.sqlite3
CHALLENGE_TIMEOUT_SECONDS=60
CHALLENGE_PHRASE=Мамой клянусь
CHALLENGE_EASY=false
UNBAN_PHRASE=Я не шлюхобот
LOG_LEVEL=INFO
